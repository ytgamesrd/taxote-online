<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- The Map Panel (Full Screen) -->
    <FrameLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/rideMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#DCEEF3" />

        <!-- Floating Menu Button (Uber Style) -->
        <Button
            android:id="@+id/menuButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:text="☰"
            android:textColor="@color/navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/rideCard"
            android:layout_width="match_parent"
            android:layout_height="370dp"
            android:layout_gravity="bottom"
            android:visibility="gone">
            <!-- Handled internally by map JS -->
        </ScrollView>
    </FrameLayout>

    <!-- App Content Scroll (Profile, Wallet, etc.) -->
    <ScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Close button for sections -->
            <Button
                android:id="@+id/closeSectionButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:text="✕"
                android:textColor="@color/navy"
                android:textSize="20sp" />

            <LinearLayout android:id="@+id/profilePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MI PERFIL" android:textColor="@color/navy" android:textSize="22sp" android:textStyle="bold" />
                <ImageView android:id="@+id/profilePhoto" android:layout_width="112dp" android:layout_height="112dp" android:layout_marginTop="18dp" android:background="@color/navy_soft" android:contentDescription="Foto del conductor" android:scaleType="centerCrop" />
                <TextView android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/profileContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/muted" android:textSize="14sp" />
                <TextView android:id="@+id/profileVehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@color/navy_soft" android:padding="14dp" android:textColor="@color/ink" android:textSize="14sp" />
                <EditText android:id="@+id/profileEmailEdit" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:hint="Correo electronico" android:inputType="textEmailAddress" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <EditText android:id="@+id/profileCurrentPassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:hint="Contrasena actual" android:inputType="textPassword" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <EditText android:id="@+id/profileNewPassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:hint="Nueva contrasena" android:inputType="textPassword" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <EditText android:id="@+id/profilePasswordConfirm" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:hint="Repetir nueva contrasena" android:inputType="textPassword" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <Button android:id="@+id/saveProfileButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:background="@drawable/bg_primary_button" android:text="Guardar correo o contrasena" android:textAllCaps="false" android:textColor="@color/surface" android:textStyle="bold" />
                <Button android:id="@+id/updateVehicleButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:backgroundTint="@color/yellow" android:text="Actualizar vehiculo" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/walletPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MI BILLETERA" android:textColor="@color/navy" android:textSize="22sp" android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@color/navy_soft" android:orientation="horizontal" android:padding="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PUNTOS" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/walletPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/navy" android:textSize="24sp" android:textStyle="bold" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginHorizontal="15dp" android:background="#DDD" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GANANCIAS" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/walletBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RD$ 0" android:textColor="@color/navy" android:textSize="24sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnDepositPoints"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/yellow"
                    android:text="Depositar Puntos"
                    android:textAllCaps="false"
                    android:textColor="@color/navy"
                    android:textStyle="bold" />

                <TextView android:id="@+id/walletToday" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:padding="8dp" android:text="Hoy: RD$ 0" android:textColor="@color/muted" android:textSize="14sp" />
                <TextView android:id="@+id/walletTrips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0 viajes completados" android:textColor="@color/muted" android:textSize="12sp" />
                <LinearLayout android:id="@+id/walletDailyHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/depositPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEPOSITAR PUNTOS" android:textColor="@color/navy" android:textSize="20sp" android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#F0F7FF" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CUENTA PARA DEPÓSITO:" android:textColor="@color/navy" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="9604085357" android:textColor="@color/navy" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Banreservas · Ahorro" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="1. Selecciona cuántos puntos necesitas:" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />

                <Spinner android:id="@+id/pointsSelector" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:paddingStart="12dp" android:paddingEnd="12dp" />

                <TextView android:id="@+id/depositPriceIndicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Monto a depositar: RD$ 0" android:textColor="@color/success" android:textSize="16sp" android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="2. Sube la foto del comprobante:" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPickProof"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#E3E3E3"
                    android:text="Elegir Foto del Depósito"
                    android:textAllCaps="false"
                    android:textColor="@color/navy" />

                <ImageView
                    android:id="@+id/imgProofPreview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp"
                    android:background="#F5F5F5"
                    android:scaleType="centerInside"
                    android:visibility="gone" />

                <TextView android:id="@+id/proofStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="Sin captura seleccionada" android:textColor="@color/danger" android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSubmitDeposit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="ENVIAR DEPÓSITO"
                    android:textAllCaps="true"
                    android:textColor="@color/surface"
                    android:textStyle="bold" />

                <Button android:id="@+id/btnCancelDeposit" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@android:color/transparent" android:text="Cancelar" android:textAllCaps="false" android:textColor="@color/muted" />
            </LinearLayout>

            <LinearLayout android:id="@+id/historyPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="HISTORIAL DE VIAJES" android:textColor="@color/navy" android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:id="@+id/chatPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHAT CON LA CENTRAL" android:textColor="@color/navy" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Escribe a la Central, a la flota o al cliente de tu servicio activo." android:textColor="@color/muted" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                    <Button android:id="@+id/chatPrivateButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:backgroundTint="@color/navy" android:text="Central" android:textAllCaps="false" android:textColor="@color/surface" android:textSize="11sp" android:textStyle="bold" />
                    <Button android:id="@+id/chatPublicButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:backgroundTint="@color/yellow" android:text="Público" android:textAllCaps="false" android:textColor="@color/navy" android:textSize="11sp" android:textStyle="bold" />
                    <Button android:id="@+id/chatRideButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_weight="1" android:backgroundTint="@color/navy_soft" android:text="Cliente" android:textAllCaps="false" android:textColor="@color/navy" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/chatMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="280dp" android:orientation="vertical" android:paddingBottom="12dp" />
                <EditText android:id="@+id/chatInput" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_card" android:hint="Escribe un mensaje" android:inputType="textCapSentences|textMultiLine" android:maxLength="1000" android:maxLines="4" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <TextView android:id="@+id/chatPhotoName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textColor="@color/muted" android:textSize="11sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
                    <Button android:id="@+id/chatPhotoButton" android:layout_width="58dp" android:layout_height="52dp" android:layout_marginEnd="7dp" android:backgroundTint="@color/yellow" android:contentDescription="Adjuntar foto" android:text="FOTO" android:textAllCaps="false" android:textColor="@color/navy" android:textSize="10sp" android:textStyle="bold" />
                    <Button android:id="@+id/chatSendButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_primary_button" android:text="Enviar" android:textAllCaps="false" android:textColor="@color/surface" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/reportPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ENVIAR REPORTE" android:textColor="@color/navy" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Informa un problema con la app, el vehículo, un servicio o cualquier situación que necesite revisar la Central." android:textColor="@color/muted" android:textSize="12sp" />
                <Spinner android:id="@+id/reportCategory" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/bg_secondary_button" android:paddingStart="12dp" android:paddingEnd="12dp" />
                <EditText android:id="@+id/reportDescription" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:gravity="top|start" android:hint="Explica qué ocurrió" android:inputType="textCapSentences|textMultiLine" android:maxLength="1500" android:padding="14dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <Button android:id="@+id/reportPhotoButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:backgroundTint="@color/yellow" android:text="Adjuntar foto (opcional)" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
                <TextView android:id="@+id/reportPhotoName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textColor="@color/muted" android:textSize="11sp" android:visibility="gone" />
                <Button android:id="@+id/reportSubmitButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/bg_primary_button" android:text="ENVIAR A LA CENTRAL" android:textColor="@color/surface" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View android:id="@+id/menuScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" android:clickable="true" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sideMenu"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="TAXOTE DRIVER" android:textColor="@color/navy" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/menuDriverName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="24dp" android:text="Conductor" android:textColor="@color/muted" android:textSize="13sp" />
        <Button android:id="@+id/menuHome" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_secondary_button" android:gravity="start|center_vertical" android:paddingStart="18dp" android:text="Mapa y servicios" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
        <Button android:id="@+id/menuProfile" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary_button" android:gravity="start|center_vertical" android:paddingStart="18dp" android:text="Mi perfil" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
        <Button android:id="@+id/menuWallet" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary_button" android:gravity="start|center_vertical" android:paddingStart="18dp" android:text="Mi billetera" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
        <Button android:id="@+id/menuHistory" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary_button" android:gravity="start|center_vertical" android:paddingStart="18dp" android:text="Historial de viajes" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
        <Button android:id="@+id/menuChat" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary_button" android:gravity="start|center_vertical" android:paddingStart="18dp" android:text="Chat con la Central" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
        <Button android:id="@+id/menuReport" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_secondary_button" android:gravity="start|center_vertical" android:paddingStart="18dp" android:text="Enviar reporte" android:textAllCaps="false" android:textColor="@color/navy" android:textStyle="bold" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:id="@+id/logoutButton" android:layout_width="match_parent" android:layout_height="54dp" android:backgroundTint="@color/navy" android:text="Cerrar aplicación" android:textAllCaps="false" android:textColor="@color/surface" android:textStyle="bold" />
        <Button android:id="@+id/closeSessionButtonApp" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="9dp" android:backgroundTint="@color/danger" android:text="Cerrar sesión" android:textAllCaps="false" android:textColor="@color/surface" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
